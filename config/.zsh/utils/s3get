#!/usr/bin/env zsh

# s3ls
#
if command -v aws >/dev/null 2>&1 && command -v peco >/dev/null 2>&1; then
  s3ls() {
    local bucket=""
    local prefix=""
    local query=""

    while getopts b:p:q:h OPT; do
      case $OPT in
        b) bucket=$OPTARG ;;
        p) prefix=$OPTARG ;;
        q) query=$OPTARG ;;
        h)
          echo "Usage: [-b bucket] [-p prefix] [-q query]" 1>&2
          return 0
          ;;
      esac
    done

    if [[ -z $bucket ]]; then
      if [[ -n $query ]]; then
        aws s3 ls | peco --query "$query" | awk '{ print $3 }'
      else
        aws s3 ls | peco | awk '{ print $3 }'
      fi
    else
      local args=("--bucket" "$bucket" "--query" "Contents[].{Key: Key}" "--max-items" "30")
      [[ -n $prefix ]] && args+=("--prefix" "$prefix")

      if [[ -n $query ]]; then
        aws s3api list-objects "${args[@]}" | peco --query "$query"
      else
        aws s3api list-objects "${args[@]}" | peco
      fi
    fi
  }

# s3get
#
  s3get() {
    local bucket=""
    local key=""

    while getopts b:k:h OPT; do
      case $OPT in
        b) bucket=$OPTARG ;;
        k) key=$OPTARG ;;
        h)
          echo "Usage: [-b bucket] [-k key]" 1>&2
          echo "s3get -b bucket -k \`s3ls -b bucket -p prefix\`" 1>&2
          return 0
          ;;
      esac
    done

    if [[ -z $bucket || -z $key ]]; then
      echo "Usage: [-b bucket] [-k key]" 1>&2
      return 1
    fi

    aws s3api get-object \
      --bucket "$bucket" \
      --key "$key" \
      "${key##*/}"
  }
fi

