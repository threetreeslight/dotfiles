#!/usr/bin/env zsh

if command -v peco >/dev/null 2>&1; then
  ppgrep() {
    local query=$1

    if [[ -n $query ]]; then
      ps aux | peco --query "$query" | awk '{ print $2 }'
    else
      ps aux | peco | awk '{ print $2 }'
    fi
  }

  ppkill() {
    local query=
    local pids=

    if [[ $1 =~ '^-' ]]; then
      query=""
    else
      query=$1
      [[ $# -gt 0 ]] && shift
    fi

    pids=$(ppgrep "$query")
    [[ -z $pids ]] && return 0

    xargs kill "$@" <<<"$pids"
  }
fi
