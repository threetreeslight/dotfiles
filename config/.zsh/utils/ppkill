#!/usr/bin/env zsh

# pick processes (multi-select with TAB) and print their PIDs
ppgrep() {
  ps aux | fzf --multi --header-lines=1 --query "$1" | awk '{ print $2 }'
}

# pick processes and kill them: ppkill [query] [-SIGNAL]
ppkill() {
  local query=
  if [[ $1 != -* ]]; then
    query=$1
    [[ $# -gt 0 ]] && shift
  fi

  local pids
  pids=$(ppgrep "$query")
  [[ -z $pids ]] && return 0

  xargs kill "$@" <<<"$pids"
}
