#!/usr/bin/env zsh
# zsh history search
if command -v peco >/dev/null 2>&1; then
  phistory() {
    local tac_cmd

    if command -v gtac >/dev/null 2>&1; then
      tac_cmd=gtac
    elif command -v tac >/dev/null 2>&1; then
      tac_cmd=tac
    else
      tac_cmd='tail -r'
    fi

    BUFFER=$(fc -l -n 1 | $tac_cmd | peco --query "$LBUFFER")
    CURSOR=${#BUFFER}
    zle -R -c
  }

  zle -N phistory
  bindkey '^R' phistory
fi
