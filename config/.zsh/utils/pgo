#!/usr/bin/env zsh

# pick a local branch (sorted by last commit)
pgb() {
  git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads \
    | fzf --query "$1" --preview 'git log --oneline --graph --color=always -20 {}'
}

# checkout a local branch
pgu() {
  local query=
  if [[ $1 != -* ]]; then
    query=$1
    [[ $# -gt 0 ]] && shift
  fi

  local branch
  branch=$(pgb "$query")
  [[ -n $branch ]] && git switch "$branch" "$@"
}

# checkout a branch including remotes (creates a tracking branch)
pgo() {
  local branch
  branch=$(
    git for-each-ref --format='%(refname:short)' --sort=-committerdate refs/heads refs/remotes \
      | grep -v '/HEAD$' \
      | fzf --query "$1" --preview 'git log --oneline --graph --color=always -20 {}'
  )
  [[ -z $branch ]] && return 0

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git switch "$branch"
  else
    git switch --track "$branch"
  fi
}
