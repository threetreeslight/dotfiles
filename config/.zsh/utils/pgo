#!/usr/bin/env zsh

if command -v git >/dev/null 2>&1 && command -v peco >/dev/null 2>&1; then
  pgb() {
    local query=$1
    if [[ -n $query ]]; then
      git for-each-ref --format='%(refname)' --sort=-committerdate refs/heads \
        | perl -pne 's{^refs/heads/}{}' \
        | peco --query "$query"
    else
      git for-each-ref --format='%(refname)' --sort=-committerdate refs/heads \
        | perl -pne 's{^refs/heads/}{}' \
        | peco
    fi
  }

  pgu() {
    local query=
    local selected_branch=

    if [[ $1 =~ '^-' ]]; then
      query=""
    else
      query=$1
      [[ $# -gt 0 ]] && shift
    fi

    selected_branch=$(pgb "$query")
    [[ -n $selected_branch ]] && git checkout "$selected_branch" "$@"
  }

  pgo() {
    local query=$1
    local selected_branch

    if [[ -n $query ]]; then
      selected_branch=$(
        git for-each-ref --format='%(refname)' --sort=-committerdate refs/heads refs/remotes refs/tags \
        | perl -pne 's{^refs/(remotes)/}{}' \
        | peco --query "$query"
      )
    else
      selected_branch=$(
        git for-each-ref --format='%(refname)' --sort=-committerdate refs/heads refs/remotes refs/tags \
        | perl -pne 's{^refs/(remotes)/}{}' \
        | peco
      )
    fi

    [[ -n $selected_branch ]] && git checkout -t "$selected_branch"
  }
fi
