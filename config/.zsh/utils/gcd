#!/usr/bin/env zsh

# change directory to a ghq managed repository via peco
if command -v ghq >/dev/null 2>&1 && command -v peco >/dev/null 2>&1; then
  gcd() {
    local selection
    if [[ -n $1 ]]; then
      selection=$(ghq list --full-path | peco --query "$1")
    else
      selection=$(ghq list --full-path | peco)
    fi

    [[ -n $selection ]] && cd "$selection"
  }
fi
