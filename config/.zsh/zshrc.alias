alias ll='ls -laG'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'
alias du='du -h'
alias df='df -h'
alias tree='tree -NC'

# delta also diffs plain files/directories: `diff a b`
if command -v delta >/dev/null 2>&1; then
  alias diff='delta'
else
  alias diff='diff -u'
fi

# ruby
alias be='bundle exec'
