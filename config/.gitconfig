[user]
  # fail instead of guessing name/email from the OS account and hostname
  # (set user.name / user.email in ~/.gitconfig.local)
  useConfigOnly = true
[color]
  ui = true
[alias]
  br = branch
  # merge-base with the remote default branch (main / master)
  branch-root = !git merge-base \"$(git default-branch)\" HEAD
  default-branch = !git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || (git show-ref --verify --quiet refs/heads/main && echo main) || echo master
  ci = commit
  co = checkout
  delete-merged-branches = !git branch --merged | grep -vE '^\\*|^[+ ] (main|master)$' | xargs -I % git branch -d %
  g = grep -H --heading --break
  lo = log --graph --decorate --oneline
  pr = !gh pr create --fill
  review = !tig --reverse -w $(git branch-root)..HEAD
  st = status --short --branch
[grep]
  lineNumber = true
[remote "origin"]
  # fetch = +refs/heads/*:refs/tags/*
  fetch = +refs/pull/*/head:refs/remotes/origin/pr/*

[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[diff]
  colorMoved = default

[include]
  path = .gitconfig.local

[branch]
  autosetuprebase = always
[ghq]
  root = ~/src

[init]
  templatedir = ~/.git_template
  defaultBranch = main
[secrets]
  providers = git secrets --aws-provider
  patterns = [A-Z0-9]{20}
  patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
  patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
  patterns = gh[pousr]_[A-Za-z0-9]{36,}
  patterns = github_pat_[A-Za-z0-9_]{50,}
  patterns = xox[baprs]-[A-Za-z0-9-]{10,}
  patterns = sk-[A-Za-z0-9_-]{20,}
  patterns = -----BEGIN[[:space:]A-Z]*PRIVATE[[:space:]]KEY-----
  patterns = (api[_-]?key|secret|token|passw(or)?d)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=_-]{16,}
[merge]
  ff = false
  conflictstyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
